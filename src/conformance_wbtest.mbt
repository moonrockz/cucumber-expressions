///|
/// Integer value of an argument, as a decimal string.
fn conformance_integer(value : ParamValue) -> String? {
  match value {
    IntVal(n) | ShortVal(n) => Some(n.to_string())
    LongVal(n) => Some(n.to_string())
    ByteVal(b) => Some(b.to_int().to_string())
    BigIntegerVal(n) => Some(n.to_string())
    _ => None
  }
}

///|
/// True when a floating point argument is close to the expected value.
fn conformance_close(value : ParamValue, expected : Double) -> Bool {
  match value {
    FloatVal(d) | DoubleVal(d) => (d - expected).abs() <= 1.0e-9
    _ => false
  }
}

///|
/// Text of an argument that the reference gives as a string.
fn conformance_text(value : ParamValue) -> String? {
  match value {
    StringVal(s) | WordVal(s) | AnonymousVal(s) => Some(s)
    BigDecimalVal(d) => Some(d.to_string())
    BigIntegerVal(n) => Some(n.to_string())
    _ => None
  }
}

///|
fn conformance_node(
  type_ : NodeType,
  start : Int,
  end : Int,
  nodes : Array[Node],
) -> Node {
  { type_, nodes, token: "", start, end, }
}

///|
